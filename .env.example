# 将此文件复制为 .env，并按需填写自己的密钥。

OPENAI_API_KEY=

# 可选的模型提供商或服务
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# 本地 RAG Embedding 后端
# 安装 Ollama 并拉取下面的模型后，使用 "ollama"：
#   ollama pull embeddinggemma:300m
# 无需联网或额外依赖时，可使用 "sparse" 作为降级方案。
RAG_EMBEDDING_BACKEND=ollama
RAG_LOCAL_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_TIMEOUT=60
RAG_MIN_SCORE=0.2

# 基于来源的本地回答生成
#   ollama pull qwen2.5:3b
# 使用 "extractive" 可跳过聊天模型，直接根据来源文本组织回答。
RAG_GENERATION_BACKEND=ollama
RAG_LOCAL_CHAT_MODEL=qwen2.5:3b
OLLAMA_GENERATE_TIMEOUT=120
RAG_MAX_CONTEXT_CHARS=6000
