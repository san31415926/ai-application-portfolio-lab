# Copy this file to .env and fill in your own keys.

OPENAI_API_KEY=

# Optional providers or services
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Local RAG embedding backend
# Use "ollama" after installing Ollama and pulling the model below:
#   ollama pull embeddinggemma:300m
# Use "sparse" for an offline dependency-free fallback.
RAG_EMBEDDING_BACKEND=ollama
RAG_LOCAL_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_TIMEOUT=60
RAG_MIN_SCORE=0.2

# Local grounded answer generation
#   ollama pull qwen2.5:3b
# Use "extractive" to skip the chat model and compose answers from source text.
RAG_GENERATION_BACKEND=ollama
RAG_LOCAL_CHAT_MODEL=qwen2.5:3b
OLLAMA_GENERATE_TIMEOUT=120
RAG_MAX_CONTEXT_CHARS=6000
